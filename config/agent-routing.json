{
  "version": 3,
  "defaultContextTokenCeiling": 15000,
  "packet": {
    "$comment": "First-orientation ceilings. Progressive disclosure, not 'read the repository first'. A real task may expand deliberately after the first packet; it may not raise these numbers to make one exceptional task convenient.",
    "maxCandidatePaths": 8,
    "maxAuthorities": 3,
    "maxSelectedSkills": 3,
    "maxSelectedRoles": 2,
    "maxPacketBytes": 8192,
    "maxNavigationQueryTokens": 1200
  },
  "skillLoadBudget": {
    "$comment": "Installed is not loaded. A role packet normally carries at most one skill per load class so complementary lenses compose instead of competing.",
    "navigation": 1,
    "process": 1,
    "domain": 1,
    "specialist": 1,
    "review": 1,
    "critic": 1
  },
  "routes": {
    "intake": {
      "kind": "deterministic-first",
      "maxTokens": 5000,
      "context": ["project intake", "questionnaire", "project type defaults"]
    },
    "research": {
      "kind": "bounded-research",
      "maxTokens": 25000,
      "context": ["intake brief", "approved source references", "bounded browser/read tools"]
    },
    "specification": {
      "kind": "specialist",
      "maxTokens": 20000,
      "context": ["approved upstream artifacts only", "project manifest", "relevant knowledge chunks"]
    },
    "implementation": {
      "kind": "specialist",
      "maxTokens": 15000,
      "context": ["manifest", "relevant contracts", "target module/files", "target tests"]
    },
    "complex-debug": {
      "kind": "specialist",
      "maxTokens": 35000,
      "context": ["manifest", "filtered failures", "relevant source/tests"]
    },
    "review": {
      "kind": "independent-review",
      "maxTokens": 20000,
      "context": ["artifact under review", "acceptance criteria", "deterministic reports", "evidence pack"]
    },
    "architecture": {
      "kind": "high-reasoning",
      "maxTokens": 60000,
      "context": ["product contract", "architecture", "affected registries/contracts"]
    },
    "visual-review": {
      "kind": "vision-review",
      "maxTokens": 15000,
      "context": ["build contract", "final screenshots", "relevant design tokens"]
    }
  },
