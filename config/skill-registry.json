{
  "version": 1,
  "description": "Repo-local specialist skills and their evaluation lifecycle. A skill is not trusted because it exists or because a model liked it.",
  "lifecycleStates": [
    "planned",
    "experimental",
    "candidate",
    "evaluated",
    "proven",
    "deprecated"
  ],
  "loadClasses": {
    "navigation": "Repository/design orientation evidence. Never authority.",
    "process": "How the work is sequenced and closed out.",
    "domain": "The subject-matter craft the role owns.",
    "specialist": "A narrow extra lens that composes with the domain skill rather than competing with it.",
    "review": "Repository-specific acceptance review.",
    "critic": "Independent pressure-test, deliberately separate from ordinary review."
  },
  "promotionRules": [
    "Promotion moves one lifecycle state at a time and requires recorded evidence.",
    "A skill reaches evaluated only with benchmark cases, quality score, token, runtime and cost evidence.",
    "A skill reaches proven only when every prior-art source it draws on is adopted-pinned with a passed security review.",
    "A replacement skill version must be compared against the incumbent before it supersedes it.",
    "A skill that regresses on its benchmark cases returns to candidate or is deprecated."
  ],
