---
import Base from '../layouts/Base.astro';
import Offer from '../components/Offer.astro';
import Plate from '../components/Plate.astro';
import Season from '../components/Season.astro';
import { studio, plants, gardens, proof } from '../data/studio';
/* Six, not eight. A reviewer read the home register as the primary task when booking is
   the commercial goal; the full register is one click away and says so. */
const register = plants.slice(0, 6);
const featured = gardens.slice(0, 3);
const lead = proof[0];
const byPlant = Object.fromEntries(plants.map((p) => [p.slug, p]));
---
<Base title="Marram — planting and landscape design, Suffolk coast" description={studio.positioning}>
  <section class="hero">
    <div class="hero-copy">
      <p class="label">Planting &amp; landscape design · Aldeburgh</p>
      <h1 class="display" style="margin-top: var(--s-3);">Gardens for salt wind and a dry August.</h1>
      <p class="lede" style="margin-top: var(--s-4);">{studio.positioning}</p>
      <p style="margin-top: var(--s-4);"><a class="ask" href="/enquire">Book a first visit · {studio.firstVisit.price}</a></p>
    </div>
    <figure class="hero-plate" style="margin:0;">
      <div class="specimen-plate"><Plate slug="eryngium" alt="Botanical plate of Eryngium maritimum, sea holly." priority sizes="(max-width: 900px) 78vw, 38vw" /></div>
      <figcaption class="hero-caption">
        <span class="latin">Eryngium maritimum</span>
        <span class="label">Sea holly · plate, Flora Batava</span>
      </figcaption>
    </figure>
  </section>

  <section class="section-tight grid hair-top">
    <div class="c-1-5">
      <p class="label">The register</p>
      <h2 class="display" style="font-size: var(--t-xxl); margin-top: var(--s-2);">We plant from a list of about forty.</h2>
    </div>
    <div class="c-7-6 end">
      <p class="prose">Every garden the studio makes is drawn from the same short register of plants that will take salt, wind and drought on this coast. It is short on purpose. A plant that needs help in its second summer is not on it.</p>
    </div>
  </section>

  <section class="grid" style="padding-bottom: var(--s-6);">
    <div class="c-full">
      <div class="register register--home">
        {register.map((plant) => (
          <article class="specimen">
            <div class="specimen-plate"><Plate slug={plant.slug} alt={`Botanical plate of ${plant.latin}, ${plant.common.toLowerCase()}.`} /></div>
            <h3 class="specimen-latin">{plant.latin}</h3>
            <p class="specimen-common">{plant.common}</p>
            <p class="specimen-role">{plant.role}</p>
            <p class="specimen-tolerance">{plant.tolerance}</p>
            <Season from={plant.season[0]} to={plant.season[1]} latin={plant.latin} />
          </article>
        ))}
      </div>
    </div>
    <div class="c-full" style="margin-top: var(--s-3);">
      <a class="ask-quiet" href="/planting">The full register — {plants.length} plants</a>
    </div>
    <div class="c-full">
      <div class="midway">
        <p>Not sure any of this will survive where you are? That is what the first visit answers.</p>
        <a class="ask-quiet" href="/enquire">Book a first visit · £450</a>
      </div>
    </div>

  </section>

  <section class="section grid hair-top">
    <div class="c-full"><p class="label">Gardens</p></div>
    {featured.map((garden) => (
      <article class="garden">
        <div class="garden-head">
          <p class="label">{garden.place} · {garden.year}</p>
          <h2 class="garden-name"><a href={`/gardens/${garden.slug}`}>{garden.name}</a></h2>
          <div class="measure">
            <span class="measure-figure">{garden.measure.figure}</span>
            <span class="measure-caption">{garden.measure.caption}</span>
          </div>
        </div>
        <div class="garden-body">
          <p class="prose" style="margin:0;">{garden.brief}</p>
          <p class="label" style="margin-top: var(--s-3);">Drawn from the register</p>
          <div class="drawn">
            {garden.plants.map((slug) => (
              <a href="/planting" title={byPlant[slug].latin}>
                <div class="specimen-plate"><Plate slug={slug} alt={`Botanical plate of ${byPlant[slug].latin}.`} sizes="68px" /></div>
                <span>{byPlant[slug].common}</span>
              </a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="section-tight grid hair-top">
    <div class="c-1-6">
      <p class="label">What clients say</p>
      <blockquote style="margin: var(--s-3) 0 0;">
        <p style="font-family: var(--font-display); font-size: var(--t-xl); line-height: 1.35; margin: 0;">“{lead.quote}”</p>
        <footer class="label" style="margin-top: var(--s-2);">{lead.who} · {lead.garden}</footer>
      </blockquote>
    </div>
    <div class="c-8-5 end">
      <Offer />
    </div>
  </section>
</Base>
