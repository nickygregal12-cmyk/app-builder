---
import Base from '../layouts/Base.astro';
import { changelog, company } from '../data/product';
const fmt = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Changelog — Plumbline" description="What changed, when, and what it fixed.">
  <section class="section-tight grid">
    <div class="c-1-7">
      <p class="label">Changelog</p>
      <h1 class="display" style="margin-top: var(--s-3);">What changed, and what it was wrong about before.</h1>
      <p class="lede" style="margin-top: var(--s-4);">Entries say what a change fixed rather than that it was an improvement. A changelog with no admissions in it is marketing.</p>
    </div>
  </section>
  <section class="grid">
    <div class="c-1-8">
      <div class="entries">
        {changelog.map((entry) => (
          <article class="entry">
            <time datetime={entry.date}>{fmt(entry.date)}</time>
            <div>
              <h3>{entry.title}</h3>
              <p>{entry.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section-tight grid">
    <div class="c-1-8">
      <div class="actions"><a class="ask" href="/start">Start a {company.trial.days}-day trial</a><a class="ask-quiet" href="/checks">See what it refuses</a></div>
    </div>
  </section>
</Base>
