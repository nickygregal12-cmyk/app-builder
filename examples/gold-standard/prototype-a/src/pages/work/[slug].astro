---
/**
 * A project.
 *
 * This is where photography is allowed to dominate: the page opens on a full-viewport frame
 * with nothing over it, and the name arrives underneath. The reference class in the
 * hospitality reading calls this label delay — you are made to look before you are told.
 *
 * The signature is the pair. A bureau that only works on existing buildings can show the half
 * of the story every other portfolio omits, so "as found" and "as left" are set as two
 * columns at different heights rather than as a before/after slider, which is a gadget.
 *
 * The page ends on the next project rather than on a call to action or a return link, because
 * somebody reading a project page wants another project.
 */
import Base from '../../layouts/Base.astro';
import Frame from '../../components/Frame.astro';
import { bureau } from '../../data/bureau';
import { shownProjects as projects } from '../../lib/frames';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const [lead, ...rest] = project.frames;
---

<Base title={`${project.left} — Nørreværk`} description={project.line}>
  {/* Nothing over the photograph. */}
  <section class="grid" style="padding-top: 0;">
    <div class="bleed">
      <Frame slug={lead.slug} alt={lead.alt} priority bleed sizes="100vw" />
    </div>
  </section>

  <section class="grid" style="padding-top: 80rem; padding-bottom: var(--band);">
    <p class="label" style="grid-column: 1 / span 4;">{project.place} · completed {project.completed}</p>
    <h1 class="t1" style="grid-column: 1 / span 10; margin-top: 20rem;">{project.left}</h1>
    <p class="t3" style="grid-column: 1 / span 7; margin-top: 30rem; color: var(--grey-2);">
      was {project.found}, {project.built}
    </p>

    <dl style="grid-column: 12 / span 4; margin-top: 30rem; display: grid; gap: 18rem;">
      <div style="border-top: 1px solid var(--hair); padding-top: 10rem;">
        <dt class="label">Area</dt>
        <dd class="t4" style="margin-top: 4rem;">{project.area.toLocaleString('en-GB')} m²</dd>
      </div>
      <div style="border-top: 1px solid var(--hair); padding-top: 10rem;">
        <dt class="label">{project.measure.caption}</dt>
        <dd class="t4" style="margin-top: 4rem;">{project.measure.figure}</dd>
      </div>
    </dl>
  </section>

  {/* The pair. */}
  <section class="pair grid" style="padding-bottom: var(--band);">
    <div class="pair-found">
      <h3>As found</h3>
      <p class="body">{project.asFound}</p>
      {rest[0] && (
        <div style="margin-top: 34rem;">
          <Frame slug={rest[0].slug} alt={rest[0].alt} ratio={rest[0].ratio} sizes="(max-width: 760px) 100vw, 38vw" credit />
        </div>
      )}
    </div>
    <div class="pair-left">
      <h3>As left</h3>
      <p class="body measure">{project.decision}</p>
      {rest[1] && (
        <div style="margin-top: 34rem;">
          <Frame slug={rest[1].slug} alt={rest[1].alt} ratio={rest[1].ratio} sizes="(max-width: 760px) 100vw, 52vw" credit />
        </div>
      )}
    </div>
  </section>

  {rest[2] && (
    <section class="grid" style="padding-bottom: var(--band);">
      <div class="bleed">
        <Frame slug={rest[2].slug} alt={rest[2].alt} bleed sizes="100vw" />
      </div>
    </section>
  )}

  {/* The action sits where the intent forms — at the end of the project that caused it —
      and it says what this particular project arrived as. A reviewer scored conversion 6
      because a generic Contact link in the header was carrying all of this on its own. */}
  <section class="grid" style="padding-bottom: var(--band-half);">
    <div style="grid-column: 1 / span 6; border-top: 1px solid var(--hair); padding-top: 16rem;">
      <p class="label">This one arrived as</p>
      <p class="t3" style="margin-top: 10rem;">an address and a photograph.</p>
    </div>
    <div style="grid-column: 8 / span 5; border-top: 1px solid var(--hair); padding-top: 16rem;">
      <p class="small measure">{bureau.survey.caveat}</p>
      <p style="margin-top: 16rem;">
        <a class="t3" href={`mailto:${bureau.contact.copenhagen.email}?subject=A%20building`}>Send us a building</a>
      </p>
      <p class="small" style="margin-top: 8rem;">
        {bureau.contact.copenhagen.email} · {bureau.survey.price} · {bureau.survey.duration}
      </p>
    </div>
  </section>

  <section class="grid">
    <div class="next" style="grid-column: 1 / -1;">
      <a href={`/work/${next.slug}`}>
        <span class="next-label label">Next</span>
        <span class="next-name">{next.left}</span>
        <span class="next-frame">
          <Frame slug={next.frames[0].slug} alt="" ratio="1" sizes="20vw" />
        </span>
      </a>
    </div>
  </section>
</Base>
