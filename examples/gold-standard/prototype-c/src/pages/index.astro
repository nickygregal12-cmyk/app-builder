---
/**
 * The opening.
 *
 * The page is a sequence of painted fields, and the pacing is carried by the paint rather than
 * by whitespace: a warm white opening, a mid ground for the light box, a near-black for the
 * technical argument, then thirty-six colours edge to edge with no margin at all. Value and
 * density change five times before the footer.
 *
 * That is deliberate and it is aimed at a known weakness. The two previous prototypes in this
 * programme both scored lowest on composition and pacing, and both were monochrome sites whose
 * only pacing instrument was vertical space. Here the ground itself is the instrument.
 */
import Base from '../layouts/Base.astro';
import Painted from '../components/Painted.astro';
import LightBox from '../components/LightBox.astro';
import { COLOURS, FAMILIES, colourBySlug, coloursIn } from '../data/colours';
import { PAINTS, EMULSION_SD } from '../data/paints';
import { inkOn } from '../lib/light';
import images from '../assets/images.json';

const hero = colourBySlug.get('ropewalk')!;
const boxColour = colourBySlug.get('sage-earth')!;
const choices = ['sage-earth', 'gold-ochre', 'venetian', 'slate', 'ropewalk', 'peat'].map((slug) => colourBySlug.get(slug)!);
const chalk = images.find((image) => image.slug === 'chalk-face')!;
const pigment = images.find((image) => image.slug === 'pigment')!;
---
<Base
  title="Marlpit — mineral paint for walls that have to breathe"
  description="Lime, silicate, clay distemper and lime-casein paints in thirty-six colours, made in Wiltshire for solid-wall and historic buildings."
  hex={hero.hex}
>
  <Painted hex={hero.hex} class="open">
    <div class="page open__in">
      <div>
        <p class="label">Mineral paint · made at Nadder Mill</p>
        <h1 class="display">Your walls have been breathing for two hundred years.</h1>
        <p class="sub">
          Then somebody painted them with plastic. A solid wall with no cavity manages water by
          letting it move — in when it rains, out when it dries. Vinyl emulsion is a film
          formulated not to let water vapour through, and a wall that cannot dry outwards dries
          into the plaster instead.
        </p>
        <p class="open__num">
          <span class="num open__big">{PAINTS[0].sd}</span>
          <span class="open__unit">metres s<sub>d</sub><br />our limewash, five coats</span>
          <span class="num open__big open__big--bad">{EMULSION_SD}</span>
          <span class="open__unit">metres s<sub>d</sub><br />vinyl emulsion</span>
        </p>
        <p class="small open__note">
          Vapour diffusion equivalent air layer thickness — how thick a layer of still air the
          coating behaves like. Lower is more open. It is the only number in this argument that
          matters and almost nobody publishes it.
        </p>
      </div>
      <figure class="open__fig">
        <img src={chalk.src} width={chalk.width} height={chalk.height} alt="A worked chalk face, white and stepped, with scrub growing along the top." loading="eager" />
        <figcaption>
          {chalk.usedAs}. Photograph {chalk.photographer}, {chalk.licence}.
        </figcaption>
      </figure>
    </div>
  </Painted>

  <Painted hex={boxColour.hex} id="light">
    <div class="page">
      <div class="sec">
        <div>
          <p class="label">The thing a card cannot do</p>
          <h2 class="head">A colour is not a colour. It is a colour under a light.</h2>
        </div>
        <p class="prose small">
          Lime paint is pigment suspended in lime and laid on thin. It moves under light in a way a
          plastic film does not: the same wall is one colour at nine in the morning and another at
          four in the afternoon, and something else again under a lamp. Choose from a card in a
          shop and you are choosing under that shop's fluorescent tubes.
        </p>
      </div>
      <LightBox colour={boxColour} choices={choices} />
    </div>
  </Painted>

  <Painted hex="#2f2820">
    <div class="page">
      <div class="sec">
        <div>
          <p class="label">Why the palette looks like this</p>
          <h2 class="head">Lime destroys most pigments. What is left is the range.</h2>
        </div>
        <p class="prose small">
          A lime binder sits around pH 12. Nearly every organic pigment and a good many synthetic
          ones fade, shift or disappear in it within a season. What survives is earths, calcined
          earths, a few mineral oxides and two blues that cost what they cost.
        </p>
      </div>

      <div class="fam">
        <figure class="fam__fig">
          <img src={pigment.small} width="1000" height="667" alt="Two heaps of pigment side by side, burnt sienna and natural sienna." loading="lazy" />
          <figcaption>{pigment.usedAs}. Photograph {pigment.photographer}, {pigment.licence}.</figcaption>
        </figure>
        <ol class="fam__list">
          {FAMILIES.map((family) => (
            <li class="fam__row">
              <div class="fam__chips">
                {coloursIn(family.id).map((colour) => (
                  <span class="fam__chip" style={`--c: ${colour.hex}`} title={colour.name}></span>
                ))}
              </div>
              <div>
                <h3 class="fam__name">{family.name}</h3>
                <p class="fam__src">{family.source}</p>
                <p class="fam__fast">{family.fastness}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <p class="small fam__absent">
        There are no bright greens here, no clean violets and no magentas. That gap is the product.
      </p>
    </div>
  </Painted>

  {/* The catalogue, edge to edge and with no page padding at all. After three sections of
      measured column the run of thirty-six colours arrives with no margin, which is the biggest
      change of density on the site and the reason it is placed here rather than on its own
      route alone. */}
  <section class="cat" aria-labelledby="cat-h">
    <div class="page cat__head">
      <p class="label">Thirty-six colours</p>
      <h2 class="head" id="cat-h">The whole range, in four paints.</h2>
      <p class="small cat__note">Ordered by light reflectance within each pigment family. <a class="u" href="/colours">The full index, with what each is made of →</a></p>
    </div>
    <div class="swatches">
      {COLOURS.map((colour) => (
        <a
          class="swatch"
          href={`/colours/${colour.slug}`}
          style={`--sw: ${colour.hex}; --sw-ink: ${inkOn(colour.hex) === 'dark' ? 'var(--ink-dark)' : 'var(--ink-light)'}`}
        >
          <span class="swatch__name">{colour.name}</span>
        </a>
      ))}
    </div>
  </section>

  <Painted hex="#ede8da">
    <div class="page">
      <div class="sec">
        <div>
          <p class="label">Four paints</p>
          <h2 class="head">Each has a disadvantage. They are on the page.</h2>
        </div>
        <p class="prose small">
          A breathable paint that could also be scrubbed, applied like emulsion and painted over
          anything would be an emulsion. Choosing one of these is choosing which compromise suits
          the wall.
        </p>
      </div>
      <table class="tbl paints">
        <thead>
          <tr><th scope="col">Paint</th><th scope="col">s<sub>d</sub></th><th scope="col">Coverage</th><th scope="col">Coats</th><th scope="col">5&nbsp;litres</th><th scope="col">The drawback</th></tr>
        </thead>
        <tbody>
          {PAINTS.map((paint) => (
            <tr>
              <th scope="row"><a class="u" href={`/paints#${paint.id}`}>{paint.name}</a>{paint.interiorOnly && <span class="paints__int">interior only</span>}</th>
              <td class="n">{paint.sd} m</td>
              <td class="n">{paint.coverage} m²/L</td>
              <td class="n">{paint.coats}</td>
              <td class="n">£{paint.price}</td>
              <td>{paint.drawback}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Painted>

  <Painted hex={colourBySlug.get('oxblood')!.hex} class="ask">
    <div class="page ask__in">
      <div>
        <p class="label">How to choose</p>
        <h2 class="display display--sm">Nothing on a screen is good enough. Put it on the wall.</h2>
      </div>
      <div class="prose">
        <p>
          Four sample pots, £22 delivered, enough for a square metre each. Paint them on the wall
          you are actually painting — not on a card, and not on the one wall in the room that gets
          the sun.
        </p>
        <p>
          If you are specifying rather than decorating, send us the building instead and we will
          write you a substrate and product recommendation. <a class="u" href="/samples">Both, and
          what they cost →</a>
        </p>
      </div>
    </div>
  </Painted>
</Base>

<style>
  .open__in { display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.86fr);
    gap: clamp(var(--s6), 4vw, var(--s9)); align-items: center; }
  .display + .sub { margin-top: var(--s5); }
  .label + .display { margin-top: var(--s4); }

  .open__num { display: grid; grid-template-columns: auto 1fr auto 1fr; gap: var(--s3) var(--s4);
    align-items: baseline; margin-top: var(--s7); padding-top: var(--s5); border-top: 1px solid var(--line-strong); }
  .open__big { font-size: clamp(2.25rem, 1.4rem + 2.4vw, 3.5rem); font-weight: 600;
    letter-spacing: -0.035em; line-height: 1; }
  .open__big--bad { color: color-mix(in srgb, var(--ink) 46%, transparent); }
  .open__unit { font-size: var(--t-label); line-height: 1.4;
    color: color-mix(in srgb, var(--ink) 68%, transparent); }
  .open__note { margin-top: var(--s4); max-width: 46ch; }

  .open__fig { margin: 0; }
  .open__fig img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .open__fig figcaption, .fam__fig figcaption { margin-top: var(--s3); font-size: var(--t-label);
    color: color-mix(in srgb, var(--ink) 62%, transparent); }

  .sec { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--s5), 4vw, var(--s8)); align-items: start; margin-bottom: var(--s7); }
  .sec .head { margin-top: var(--s3); }

  .fam { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(var(--s6), 4vw, var(--s8)); align-items: start; }
  .fam__fig { margin: 0; position: sticky; top: var(--s5); }
  .fam__fig img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  .fam__list { border-top: 1px solid var(--line-strong); }
  .fam__row { display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: var(--s5);
    padding-block: var(--s5); border-bottom: 1px solid var(--line); align-items: start; }
  .fam__chips { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
  .fam__chip { display: block; aspect-ratio: 1; background: var(--c); }
  .fam__name { font-size: var(--t-body); font-weight: 600; }
  .fam__src { margin-top: var(--s2); font-size: var(--t-small);
    color: color-mix(in srgb, var(--ink) 84%, transparent); }
  .fam__fast { margin-top: var(--s2); font-size: var(--t-small);
    color: color-mix(in srgb, var(--ink) 62%, transparent); }
  .fam__absent { margin-top: var(--s6); padding-top: var(--s4); border-top: 1px solid var(--line);
    max-width: 60ch; }

  .cat { background: var(--ink-dark); color: var(--ink-light); padding-top: clamp(var(--s8), 5vw, 104px); }
  .cat__head { --ink: var(--ink-light); --line: color-mix(in srgb, var(--ink-light) 22%, transparent);
    margin-bottom: var(--s7); }
  .cat__head .head { margin-top: var(--s3); }
  .cat__note { margin-top: var(--s4); color: color-mix(in srgb, var(--ink-light) 74%, transparent); }

  .paints th[scope='row'] { font-family: var(--display); font-weight: 600; padding-right: var(--s5); }
  .paints__int { display: block; font-family: var(--display); font-size: var(--t-label);
    font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 58%, transparent); margin-top: 2px; }

  .ask__in { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(var(--s6), 4vw, var(--s8)); align-items: end; }
  .display--sm { font-size: clamp(1.875rem, 1.1rem + 2.6vw, 3.25rem); max-width: 18ch; margin-top: var(--s4); }

  @media (max-width: 980px) {
    .open__in, .sec, .fam, .ask__in { grid-template-columns: 1fr; }
    .fam__fig { position: static; }
    .fam__fig img { aspect-ratio: 16 / 9; }
    .open__fig img { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 700px) {
    .open__num { grid-template-columns: auto 1fr; }
    .fam__row { grid-template-columns: 96px minmax(0, 1fr); gap: var(--s4); }
    /* The paints table becomes a stack of records rather than a squeezed grid: six columns at
       390px would give the drawback — the column that decides the purchase — about eight
       characters a line. */
    .paints, .paints tbody, .paints tr, .paints td, .paints th { display: block; width: 100%; }
    .paints thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .paints tr { padding-block: var(--s4); border-bottom: 1px solid var(--line); }
    .paints th, .paints td { border: 0; padding: 0; }
    .paints td.n { display: inline-block; width: auto; margin-right: var(--s4); margin-top: var(--s2);
      font-size: var(--t-label); color: color-mix(in srgb, var(--ink) 66%, transparent); }
    .paints td:last-child { margin-top: var(--s3); }
  }
</style>
