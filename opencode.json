{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "app-builder": {
      "type": "local",
      "command": ["npm", "run", "mcp"],
      "enabled": true,
      "environment": {
        "APP_BUILDER_SERVICE_URL": "http://127.0.0.1:4310"
      }
    }
  },
  "permission": {
    "bash": "deny",
    "edit": "deny",
    "webfetch": "deny"
  },
  "share": "disabled",
  "autoupdate": false
}
