    {"id":"ai_inputs","label":"What information will users give the AI?","type":"multi-select","depth":"quick","impact":"high","options":["text","images","documents","spreadsheets","audio","structured data","external APIs"]},
    {"id":"ai_outputs","label":"What should the AI produce?","type":"multi-select","depth":"quick","impact":"high","options":["text","structured data","images","documents/reports","decisions/recommendations","tool actions"]},
    {"id":"uploads","label":"Will users upload files for AI processing?","type":"boolean","depth":"standard","impact":"high","default":false},
    {"id":"human_review","label":"Must AI output be reviewed before it has an effect?","type":"boolean","depth":"standard","impact":"high","default":true},
    {"id":"ai_sensitivity","label":"Will prompts or outputs contain confidential or regulated data?","type":"single-select","depth":"standard","impact":"high","default":"normal","options":["normal","confidential","regulated/unknown"]},
    {"id":"model_constraint","label":"Is a specific AI provider/model required?","type":"text","depth":"thorough","impact":"normal"},
    {"id":"ai_cost_priority","label":"Optimise AI usage for","type":"single-select","depth":"standard","impact":"normal","default":"balanced","options":["lowest-cost","balanced","highest-quality"]}
