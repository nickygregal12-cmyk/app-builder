{
  "version":"1.3.0","id":"base",
  "principles":["ask only relevant questions","prefer structured options/defaults","flag high-impact ambiguity before build","allow explicit decide-for-me answers"],
  "questions":[
    {"id":"project_type","label":"What are you building?","type":"single-select","required":true,"depth":"quick","impact":"blocking","options":["marketing-site","b2b-saas","consumer-app","internal-tool","content-site","ai-app"]},
    {"id":"project_name","label":"What should this project be called?","type":"text","required":true,"depth":"quick","impact":"blocking","placeholder":"e.g. TenderCheck"},
    {"id":"primary_goal","label":"What is the single most important outcome?","type":"textarea","required":true,"depth":"quick","impact":"blocking"},
    {"id":"target_users","label":"Who is it for?","type":"textarea","required":true,"depth":"quick","impact":"blocking"},
    {"id":"must_have","label":"What must V1 let users do?","type":"list","required":true,"depth":"quick","impact":"blocking"},
    {"id":"major_surfaces","label":"Which major pages or screens do you already know V1 needs?","type":"list","depth":"standard","impact":"normal","placeholder":"Leave blank to use project-type defaults"},
    {"id":"out_of_scope","label":"What should V1 explicitly not include?","type":"list","depth":"standard","impact":"normal"},
    {"id":"existing_inputs","label":"What source material do you already have?","type":"multi-select","depth":"standard","impact":"normal","options":["existing website","logo/brand","photos","screenshots","PDFs/docs","spreadsheets/CSV","database/API","none"]},
    {"id":"design_control","label":"How much should the factory decide?","type":"single-select","depth":"quick","impact":"normal","default":"sensible-defaults","options":["sensible-defaults","show-design-directions","closely-follow-reference"]},
    {"id":"cost_priority","label":"Optimise external running costs for","type":"single-select","depth":"quick","impact":"normal","default":"lowest-sensible-cost","options":["lowest-sensible-cost","balanced","performance-first"]},
    {"id":"expected_scale","label":"Roughly how many users or visitors do you expect in the first year?","type":"single-select","depth":"standard","impact":"high","default":"under-1000","options":["under-100","under-1000","1000-10000","10000-plus","unknown"]},
    {"id":"hard_constraints","label":"Are there any technologies, providers, budgets, deadlines or other hard constraints?","type":"list","depth":"thorough","impact":"high"}
  ]
}
