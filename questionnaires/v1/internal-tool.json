{
  "version":"1.0.0",
  "id":"internal-tool",
  "extends":"base",
  "questions":[
    {"id":"internal_users","label":"Which teams or roles will use the tool?","type":"list","required":true},
    {"id":"permissions","label":"Do different users need different permissions?","type":"single-select","default":"simple","options":["none","simple","complex/custom","decide for me"]},
    {"id":"data_sources","label":"Where does the current data/workflow live?","type":"multi-select","options":["spreadsheets","documents","database","third-party API","email/manual process","new system"]},
    {"id":"integrations","label":"What existing systems must it connect to?","type":"list","required":false},
    {"id":"sensitivity","label":"How sensitive is the data?","type":"single-select","default":"normal-business-data","options":["normal-business-data","confidential","regulated/unknown"]}
  ]
}
