{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "App Builder Infrastructure Adapter",
  "type": "object",
  "required": ["schemaVersion","id","kind","version","status","compatibleTemplates","files","package"],
  "properties": {
    "schemaVersion": {"const":1},
    "id": {"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "kind": {"enum":["backend","deployment"]},
    "version": {"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "status": {"enum":["draft","ready","deprecated"]},
    "compatibleTemplates": {"type":"array","minItems":1,"items":{"type":"string"}},
    "files": {"type":"array","items":{"type":"string"}},
    "package": {
      "type":"object",
      "required":["dependencies","devDependencies","scripts"],
      "properties": {
        "dependencies":{"type":"object","additionalProperties":{"type":"string"}},
        "devDependencies":{"type":"object","additionalProperties":{"type":"string"}},
        "scripts":{"type":"object","additionalProperties":{"type":"string"}}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties": false
}
