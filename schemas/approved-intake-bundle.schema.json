{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"App Builder Approved Intake Bundle",
  "description":"Everything needed to recreate an approved Build Contract and Manifest without asking the operator to re-key questionnaire answers. It carries approved intent, never generated output.",
  "type":"object",
  "required":["schemaVersion","bundleId","createdAt","provenance","questionnaire","intake","buildContract","buildContractHash","projectManifest","projectManifestHash"],
  "properties":{
    "schemaVersion":{"const":1},
    "bundleId":{"type":"string","minLength":1},
    "createdAt":{"type":"string","minLength":1},
    "provenance":{
      "type":"object",
      "required":["producedBy","factoryEngineVersion"],
      "properties":{
        "producedBy":{"enum":["console-intake","service-replay","operator-authored"]},
        "factoryEngineVersion":{"type":"number"},
        "note":{"type":"string"},
        "replacesUnrecoverableIntake":{
          "type":"object",
          "description":"Set only when this bundle stands in for an approved intake that genuinely cannot be recovered. It is a new baseline, not a reconstruction of the lost original.",
          "required":["reason","baselineFrom"],
          "properties":{
            "reason":{"type":"string","minLength":1},
            "baselineFrom":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
          },
          "additionalProperties":false
        },
        "replayedFromBundleId":{"type":"string"}
      },
      "additionalProperties":false
    },
    "questionnaire":{
      "type":"object",
      "required":["version","projectType","mode","questionIds"],
      "properties":{
        "version":{"type":"string","minLength":1},
        "projectType":{"enum":["marketing-site","b2b-saas","consumer-app","internal-tool","content-site","ai-app"]},
        "mode":{"enum":["quick","standard","thorough"]},
        "questionIds":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "requiredQuestionIds":{"type":"array","items":{"type":"string","minLength":1}}
      },
      "additionalProperties":false
    },
    "intake":{
      "type":"object",
      "required":["answers","acceptedDefaults","capabilityDecisions","sourceReferences"],
      "properties":{
        "answers":{"type":"object"},
        "acceptedDefaults":{
          "type":"array",
          "description":"Questions the operator left at the questionnaire default, with the evidence recorded at approval time. A default is a decision, so replay must show it as one.",
          "items":{
            "type":"object",
            "required":["questionId","value"],
            "properties":{
              "questionId":{"type":"string","minLength":1},
              "value":{},
              "evidenceId":{"type":"string"},
              "detail":{"type":"string"}
            },
            "additionalProperties":false
          }
        },
        "capabilityDecisions":{"type":"object"},
        "sourceReferences":{"type":"array","items":{"$ref":"source-reference.schema.json"}},
        "feedback":{"type":"array","items":{"$ref":"intake-feedback.schema.json"}}
      },
      "additionalProperties":false
    },
    "buildContract":{"$ref":"build-contract.schema.json"},
    "buildContractHash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "projectManifest":{"$ref":"project-manifest.schema.json"},
    "projectManifestHash":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties":false
}
