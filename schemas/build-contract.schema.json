{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Reviewed Build Contract",
  "type":"object",
  "required":["version","status","project","audience","entities","company","constraints","coreJourneys","majorSurfaces","requestedModules","enabledModules","customWorkModules","excludedModules","capabilityPlan","infrastructure","brandDesignDirection","sourceInputs","explicitlyExcluded","acceptanceCriteria","unresolvedHighImpactQuestions","unresolvedCapabilityDecisions","ambiguityFollowUp","estimatedAiCostMode"],
  "properties":{
    "version":{"const":2},
    "status":{"enum":["draft","ready-for-review","approved"]},
    "project":{"type":"object","required":["name","type","primaryGoal","targetUsers"]},
    "audience":{"type":"object","required":["summary","roles"]},
    "entities":{"type":"array","items":{"type":"string"}},
    "company":{"type":"object"},
    "constraints":{"type":"object"},
    "coreJourneys":{"type":"array","items":{"type":"string"}},
    "majorSurfaces":{"type":"array","minItems":1,"items":{"type":"string"}},
    "requestedModules":{"type":"array","items":{"type":"string"}},
    "enabledModules":{"type":"array","items":{"type":"string"}},
    "customWorkModules":{"type":"array","items":{"type":"string"}},
    "excludedModules":{"type":"array","items":{"type":"string"}},
    "capabilityPlan":{"type":"array","items":{"type":"object","required":["module","availability","decision"],"properties":{"module":{"type":"string"},"availability":{"type":"string"},"decision":{"enum":["include","exclude","custom-work","unresolved"]}},"additionalProperties":false}},
    "infrastructure":{"type":"object","required":["backend","deployment"]},
    "brandDesignDirection":{"type":"string"},
    "designDirection":{"type":"string"},
    "sourceInputs":{"type":"array","items":{"$ref":"source-reference.schema.json"}},
    "explicitlyExcluded":{"type":"array","items":{"type":"string"}},
    "acceptanceCriteria":{"type":"array","items":{"type":"string"}},
    "unresolvedHighImpactQuestions":{"type":"array","items":{"type":"string"}},
    "unresolvedCapabilityDecisions":{"type":"array","items":{"type":"string"}},
    "ambiguityFollowUp":{"$ref":"ambiguity-followup.schema.json"},
    "estimatedAiCostMode":{"type":"object","required":["mode","maxBuildCostGbp"]},
    "approvedAt":{"type":"string"}
  },
  "additionalProperties":false
}
