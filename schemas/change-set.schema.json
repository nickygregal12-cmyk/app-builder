{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-builder.local/schemas/change-set.schema.json",
  "title": "App Builder ChangeSet",
  "type": "object",
  "required": ["schemaVersion", "id", "taskId", "objective", "allowedFiles", "forbiddenFiles", "acceptanceChecks", "rollback"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "taskId": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "expectedFiles": {"type": "array", "items": {"type": "string"}},
    "allowedFiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbiddenFiles": {"type": "array", "items": {"type": "string"}},
    "acceptanceChecks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "securityImpact": {"type": "string"},
    "rollback": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string"}
  },
  "additionalProperties": false
}
