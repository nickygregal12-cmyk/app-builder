{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://app-builder.local/schemas/composition.schema.json",
  "title":"Deterministic Project Composition",
  "type":"object",
  "required":["schemaVersion","compositionVersion","projectType","input","pages","sections","warnings","compositionHash"],
  "properties":{
    "schemaVersion":{"const":1},
    "compositionVersion":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "projectType":{"enum":["marketing-site","b2b-saas","consumer-app","internal-tool","content-site","ai-app"]},
    "input":{"type":"object","required":["manifestVersion","knowledgePackHash","assetDecisionsHash"],"properties":{"manifestVersion":{"type":"integer","minimum":1},"knowledgePackHash":{"type":["string","null"]},"assetDecisionsHash":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$","description":"Which per-asset publication decisions this composition was built with, so a decision made after a build reads as newer than the build."}},"additionalProperties":false},
    "pages":{"type":"array","minItems":1,"items":{"$ref":"page-spec.schema.json"}},
    "sections":{"type":"array","minItems":1,"items":{"$ref":"section-spec.schema.json"}},
    "warnings":{"type":"array","items":{"type":"string"}},
    "compositionHash":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  },
  "additionalProperties":false
}
