{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-builder.local/schemas/control-task.schema.json",
  "title": "App Builder Control Task",
  "type": "object",
  "required": ["schemaVersion", "id", "projectId", "objective", "acceptanceCriteria", "policyId", "budget", "state", "attempt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "projectId": {"type": "string", "minLength": 1},
    "parentTaskId": {"type": ["string", "null"]},
    "objective": {"type": "string", "minLength": 1},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "policyId": {"type": "string", "minLength": 1},
    "requestedSkills": {"type": "array", "items": {"type": "string"}},
    "budget": {
      "type": "object",
      "required": ["maxIterations", "maxRuntimeMs", "maxCostGbp", "maxTokens", "maxNoProgressAttempts"],
      "properties": {
        "maxIterations": {"type": "integer", "minimum": 1},
        "maxRuntimeMs": {"type": "integer", "minimum": 1000},
        "maxCostGbp": {"type": "number", "minimum": 0},
        "maxTokens": {"type": "integer", "minimum": 0},
        "maxNoProgressAttempts": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "state": {"enum": ["queued", "running", "blocked", "awaiting-approval", "succeeded", "failed", "cancelled"]},
    "attempt": {"type": "integer", "minimum": 0},
    "latestCheckpointId": {"type": ["string", "null"]},
    "stopReason": {"type": ["string", "null"]},
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"}
  },
  "additionalProperties": false
}
