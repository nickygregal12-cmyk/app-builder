{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-builder.local/schemas/design-contract.schema.json",
  "title": "App Builder Design Contract",
  "type": "object",
  "required": ["schemaVersion", "personality", "density", "typography", "hierarchy", "responsive", "motion", "imagery", "interaction"],
  "properties": {
    "schemaVersion": {"const": 1},
    "personality": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "density": {"enum": ["relaxed", "comfortable", "compact", "dense"]},
    "typography": {
      "type": "object",
      "required": ["strategy"],
      "properties": {
        "strategy": {"type": "string", "minLength": 1},
        "displayDirection": {"type": ["string", "null"]},
        "bodyDirection": {"type": ["string", "null"]},
        "scale": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "hierarchy": {
      "type": "object",
      "properties": {
        "primaryAttention": {"type": "string"},
        "ctaPriority": {"type": "array", "items": {"type": "string"}},
        "surfaceLevels": {"type": "integer", "minimum": 1, "maximum": 6}
      },
      "additionalProperties": false
    },
    "colour": {
      "type": "object",
      "properties": {
        "usage": {"type": "string"},
        "contrast": {"enum": ["soft", "standard", "high"]},
        "semanticRolesRequired": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "spacingRhythm": {"type": ["string", "null"]},
    "cornerLanguage": {"type": ["string", "null"]},
    "responsive": {
      "type": "object",
      "required": ["mobilePriority", "desktopPriority"],
      "properties": {
        "mobilePriority": {"type": "string"},
        "desktopPriority": {"type": "string"},
        "tabletNotes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "required": ["intensity", "reducedMotionRequired"],
      "properties": {
        "intensity": {"enum": ["none", "subtle", "moderate", "expressive"]},
        "purpose": {"type": ["string", "null"]},
        "reducedMotionRequired": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "imagery": {
      "type": "object",
      "required": ["direction"],
      "properties": {
        "direction": {"type": "string"},
        "avoid": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "required": ["feedback"],
      "properties": {
        "feedback": {"type": "string"},
        "hoverImportance": {"enum": ["low", "medium", "high"]},
        "touchFirst": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "adopt", "avoid"],
        "properties": {
          "sourceId": {"type": "string"},
          "adopt": {"type": "array", "items": {"type": "string"}},
          "avoid": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
