{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "App Builder Intake Session",
  "type": "object",
  "required": ["schemaVersion", "questionnaireVersion", "projectType", "mode", "status", "answers", "unresolvedHighImpactQuestions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "questionnaireVersion": {"type": "string"},
    "projectType": {"enum": ["marketing-site", "b2b-saas", "consumer-app", "internal-tool", "content-site", "ai-app"]},
    "mode": {"enum": ["quick", "standard", "thorough"]},
    "status": {"enum": ["in-progress", "ready-for-review", "approved"]},
    "answers": {"type": "object"},
    "unresolvedHighImpactQuestions": {"type": "array", "items": {"type": "string"}},
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"}
  },
  "additionalProperties": true
}
