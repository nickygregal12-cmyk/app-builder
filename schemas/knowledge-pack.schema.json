{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "App Builder Knowledge Pack",
  "type": "object",
  "required": ["schemaVersion", "intelligenceVersion", "project", "sources", "facts", "companyProfile", "brand", "assets", "content", "chunks", "references", "requirements", "research", "generatedCopy", "packHash"],
  "properties": {
    "schemaVersion": {"const": 1},
    "intelligenceVersion": {"type": "string", "minLength": 1},
    "project": {"type": ["object", "null"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "provenance", "rightsStatus", "assetStatus", "sourceRole", "sourceChannel", "instructionAuthority", "publishUseAllowed", "contentHash"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "provenance": {"enum": ["user-supplied", "existing-site", "external-research", "generated"]},
          "rightsStatus": {"enum": ["approved-for-use", "reference-only", "unknown", "restricted"]},
          "assetStatus": {"enum": ["approved", "suggested", "generated", "rejected", "do-not-use"]},
          "sourceRole": {"enum": ["primary-brand", "brand-supporting", "content", "requirement", "research"]},
          "sourceChannel": {"enum": ["upload", "website", "facebook", "instagram", "linkedin", "other-public"]},
          "instructionAuthority": {"const": "none"},
          "publishUseAllowed": {"type": "boolean"},
          "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "facts": {"type": "array", "items": {"type": "object", "required": ["id", "path", "value", "sourceId", "provenance", "confidence", "verification", "evidence"], "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "value": {}, "sourceId": {"type": "string"}, "provenance": {"enum": ["user-supplied", "existing-site", "external-research", "generated"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "verification": {"enum": ["user-provided", "candidate", "verified", "rejected"]}, "evidence": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": false}},
    "companyProfile": {"$ref": "company-profile.schema.json"},
    "brand": {
      "type": "object",
      "required": ["colors", "fontFamilies", "titles", "sourceCandidates", "logoCandidates", "screenshotCandidates", "publishableAssetIds", "referenceOnlyAssetIds", "generatedBrandClaims"],
      "properties": {
        "colors": {"type": "array"},
        "fontFamilies": {"type": "array"},
        "titles": {"type": "array"},
        "sourceCandidates": {"type": "array", "items": {"type": "object", "required": ["sourceId", "role", "channel", "rightsStatus", "publishUseAllowed"]}},
        "logoCandidates": {"type": "array", "items": {"type": "string"}},
        "screenshotCandidates": {"type": "array", "items": {"type": "string"}},
        "publishableAssetIds": {"type": "array", "items": {"type": "string"}},
        "referenceOnlyAssetIds": {"type": "array", "items": {"type": "string"}},
        "generatedBrandClaims": {"type": "array"}
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sourceId", "kind", "contentHash", "provenance", "rightsStatus", "assetStatus", "sourceRole", "sourceChannel", "instructionAuthority", "publishUseAllowed"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sourceId": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "provenance": {"enum": ["user-supplied", "existing-site", "external-research", "generated"]},
          "rightsStatus": {"enum": ["approved-for-use", "reference-only", "unknown", "restricted"]},
          "assetStatus": {"enum": ["approved", "suggested", "generated", "rejected", "do-not-use"]},
          "sourceRole": {"enum": ["primary-brand", "brand-supporting", "content", "requirement", "research"]},
          "sourceChannel": {"enum": ["upload", "website", "facebook", "instagram", "linkedin", "other-public"]},
          "instructionAuthority": {"const": "none"},
          "publishUseAllowed": {"type": "boolean"}
        }
      }
    },
    "content": {"type": "array", "items": {"type": "object"}},
    "chunks": {"type": "array", "items": {"type": "object", "required": ["id", "contentHash", "text", "sourceIds", "provenance", "approxTokens"], "properties": {"id": {"type": "string"}, "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "text": {"type": "string"}, "sourceIds": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "provenance": {"type": "string"}, "approxTokens": {"type": "integer", "minimum": 0}}, "additionalProperties": false}},
    "references": {"type": "array", "items": {"type": "object"}},
    "requirements": {"type": "array", "items": {"type": "object"}},
    "research": {"type": "array", "items": {"type": "object"}},
    "generatedCopy": {"type": "array", "items": {"type": "object"}},
    "packHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
