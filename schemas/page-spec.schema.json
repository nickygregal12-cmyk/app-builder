{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://app-builder.local/schemas/page-spec.schema.json",
  "title":"Composition Page Spec",
  "type":"object",
  "required":["id","path","title","purpose","navigation","sectionIds"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "path":{"type":"string","pattern":"^/"},
    "title":{"type":"string","minLength":1},
    "purpose":{"type":"string","minLength":1},
    "navigation":{"type":"object","required":["label","order","visible"],"properties":{"label":{"type":"string","minLength":1},"order":{"type":"integer","minimum":0},"visible":{"type":"boolean"}},"additionalProperties":false},
    "primaryAction":{"type":["object","null"],"properties":{"label":{"type":"string"},"href":{"type":"string"}},"required":["label","href"],"additionalProperties":false},
    "sectionIds":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true}
  },
  "additionalProperties":false
}
