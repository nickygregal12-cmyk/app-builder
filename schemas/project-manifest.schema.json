{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-builder.local/schemas/project-manifest.schema.json",
  "title": "App Builder Project Manifest",
  "type": "object",
  "required": ["schemaVersion","project","modules","infrastructure","aiBudget"],
  "properties": {
    "schemaVersion": {"enum":[1,2]},
    "project": {"type":"object","required":["name","slug","type","primaryGoal"],"properties":{"name":{"type":"string","minLength":1,"pattern":"\\S"},"slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"type":{"enum":["marketing-site","b2b-saas","consumer-app","internal-tool","content-site","ai-app"]},"primaryGoal":{"type":"string","minLength":1,"pattern":"\\S"},"siteUrl":{"type":"string","pattern":"^https?://","description":"Where this site will actually live, when that is a decided fact rather than a guess. It is optional because it usually is not known at generation time, and it is never inferred: a canonical link, an og:url and a WebSite object are all claims about a deployment address, and the factory withholds all three rather than invent one. Supplying it makes them appear in the built document."}}},
    "audience": {"type":"object","required":["summary","roles"],"properties":{"summary":{"type":"string"},"roles":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},
    "journeys": {"type":"array","items":{"type":"string"}},
    "majorSurfaces": {"type":"array","minItems":1,"items":{"type":"string"}},
    "entities": {"type":"array","items":{"type":"string"}},
    "company": {"type":"object","properties":{"identity":{"type":"object","additionalProperties":{"type":"string"}},"services":{"type":"array","items":{"type":"string"}},"locations":{"type":"array","items":{"type":"string"}},"contactDetails":{"type":"object","additionalProperties":{"type":"string"}},"socialProfiles":{"type":"array","items":{"type":"object","required":["url"],"properties":{"platform":{"type":"string","minLength":1},"url":{"type":"string","pattern":"^https?://"}},"additionalProperties":false}},"trustSignals":{"type":"array","items":{"type":"string"}},"conversionGoals":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},
    "constraints": {"type":"object","required":["customCapabilities","excludedCapabilities","unresolvedCapabilities"],"properties":{"hard":{"type":"array","items":{"type":"string"}},"expectedScale":{"type":"string"},"sensitivity":{"type":"string"},"tenantModel":{"type":"string"},"integrations":{"type":"array","items":{"type":"string"}},"existingData":{"type":"array","items":{"type":"string"}},"uploadTypes":{"type":"array","items":{"type":"string"}},"customCapabilities":{"type":"array","items":{"type":"string"}},"excludedCapabilities":{"type":"array","items":{"type":"string"}},"unresolvedCapabilities":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},
    "modules": {"type":"object","additionalProperties":{"type":"boolean"}},
    "infrastructure": {"type":"object","required":["backend","deployment"],"properties":{"backend":{"enum":["none","supabase"]},"deployment":{"enum":["netlify","cloudflare","vercel","none"]}}},
    "aiBudget": {"type":"object","required":["mode","maxBuildCostGbp"],"properties":{"mode":{"enum":["economy","balanced","quality"]},"maxBuildCostGbp":{"type":"number","minimum":0}}},
    "brand": {"type":"object"},
    "inputs": {"type":"object"},
    "outOfScope": {"type":"array","items":{"type":"string"}}
  },
  "allOf": [
    {
      "if": {"properties":{"schemaVersion":{"const":2}}},
      "then": {
        "required":["audience","journeys","majorSurfaces","entities","company","constraints","brand","inputs","outOfScope"],
        "properties": {
          "audience": true,
          "journeys": true,
          "majorSurfaces": true,
          "entities": true,
          "company": true,
          "constraints": true,
          "brand": true,
          "inputs": true,
          "outOfScope": true
        }
      }
    }
  ],
  "additionalProperties": true
}
