{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-builder.local/schemas/recipe-upgrade-proposal.schema.json",
  "title": "App Builder Recipe Upgrade Proposal",
  "type": "object",
  "required": ["schemaVersion", "recipeId", "fromVersion", "toVersion", "status", "modifiedManagedFiles", "missingManagedFiles", "reason"],
  "properties": {
    "schemaVersion": {"const": 1},
    "recipeId": {"type": "string", "minLength": 1},
    "fromVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "toVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status": {"enum": ["no-op", "ready", "review-required", "blocked"]},
    "modifiedManagedFiles": {"type": "array", "items": {"type": "string"}},
    "missingManagedFiles": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string", "minLength": 1},
    "requiredChecks": {"type": "array", "items": {"type": "string"}},
    "migrationNotes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
