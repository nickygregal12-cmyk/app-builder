{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "App Builder Recipe",
  "type": "object",
  "required": ["schemaVersion","id","module","version","status","compatibleTemplates","entry","files","requires","requiresAdapters","conflicts"],
  "properties": {
    "schemaVersion": {"const":1},
    "id": {"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "module": {"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "status": {"enum":["draft","ready","deprecated"]},
    "compatibleTemplates": {"type":"array","minItems":1,"items":{"type":"string"}},
    "entry": {"type":"string","minLength":1},
    "files": {"type":"array","items":{"type":"string"}},
    "requires": {"type":"array","items":{"type":"string"}},
    "requiresAdapters": {"type":"array","items":{"type":"string"}},
    "conflicts": {"type":"array","items":{"type":"string"}},
    "package": {
      "type":"object",
      "properties": {
        "dependencies":{"type":"object","additionalProperties":{"type":"string"}},
        "devDependencies":{"type":"object","additionalProperties":{"type":"string"}},
        "scripts":{"type":"object","additionalProperties":{"type":"string"}}
      },
      "additionalProperties":false
    },
    "database": {
      "type":"object",
      "properties": {
        "adapter":{"type":"string"},
        "fragments":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":false
    },
    "upgrade": {
      "type":"object",
      "properties": {
        "compatibleFrom":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"}},
        "migrationNotes":{"type":"array","items":{"type":"string"}},
        "alwaysReview":{"type":"boolean"}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties": false
}
