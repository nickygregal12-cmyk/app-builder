---
import { socialProfiles } from '../lib/composition';

interface Props { profiles: unknown }
const entries = socialProfiles(Astro.props.profiles);
---
{entries.length > 0 && (
  <ul class="social-links">
    {entries.map((item) => (
      <li><a href={item.url} rel="noopener noreferrer" target="_blank">{item.platform}</a></li>
    ))}
  </ul>
)}
