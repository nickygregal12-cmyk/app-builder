---
/**
 * The frame every route is served in.
 *
 * This is the difference the static renderer exists to make. The application
 * renderer ships one document with an empty root and lets the browser discover
 * the site; here every route is its own document, with its own title, its own
 * description and its own content already in the bytes the server sent.
 *
 * The design is not re-decided. `design.shellClasses` is compiled by the
 * factory from the promoted ArtDirectionPlan and its ResponsiveCompositionPlan,
 * and it is the same class list the application renderer carries — which is why
 * the same stylesheet, the same tokens and the same promoted visual direction
 * apply without a second design system underneath them.
 */
import type { PageSpec, VisualDirection } from '../lib/composition';
import { siteHref, binding, itemTitle, text } from '../lib/composition';
import { composition } from '../generated/composition';
import { design } from '../generated/design';
import { project } from '../generated/project';
import { recipeBodyEnd, recipeHead, installedRecipes } from '../generated/recipes';
import SocialLinks from '../components/SocialLinks.astro';
import { currentScenario } from '../scenarios';
import type { ProjectComposition } from '../lib/composition';
import '../design/tokens.css';
import '../generated/brand.css';
import '../styles.css';

// Any bespoke presentation this project carries, loaded last so it can answer
// the one section the Presentation Registry could not. The glob is the whole
// integration: the template loads whatever is in the directory, so a fulfilment
// writes its own file and never edits a shared one. A project with none — which
// is almost every project — resolves to nothing and costs nothing.
import.meta.glob('../presentation/bespoke/*.css', { eager: true });

interface Props { page: PageSpec }
const { page } = Astro.props;

const composed = composition as unknown as ProjectComposition;
const directed = design as unknown as VisualDirection;
const MOBILE_HERO = directed.artDirection?.responsive?.mobileHero ?? 'copy-first';
const SHELL_CLASSES = directed.shellClasses ?? directed.shellClass ?? '';

/**
 * What the header is made of.
 *
 * The last shared element, and the first one a visitor sees. Every direction
 * used to carry the same bar — brand left, destinations right, a filled pill on
 * the current page — so a serif editorial document and a mono technical
 * register announced themselves identically.
 *
 * This replaced `responsive.navigation`, which decided whether the row
 * collapsed on a phone while nothing decided what the row *was*. One element
 * cannot have two authorities, so the family owns both: every family discloses
 * behind a control on a phone, in its own character.
 */
const NAVIGATION_FAMILIES = ['utility', 'editorial', 'register', 'centred'] as const;
type NavigationFamily = (typeof NAVIGATION_FAMILIES)[number];
const declaredNav = directed.artDirection?.dimensions?.navigationFamily;
const NAVIGATION_FAMILY: NavigationFamily = (NAVIGATION_FAMILIES as readonly string[]).includes(declaredNav ?? '')
  ? (declaredNav as NavigationFamily)
  : 'utility';

const navigation = [...composed.pages].filter((entry) => entry.navigation.visible).sort((a, b) => a.navigation.order - b.navigation.order);

/**
 * The conversion action a working header carries.
 *
 * Two rules, both learned from the same defect. It belongs in a working header
 * and nowhere else — an editorial masthead that grew a filled button would stop
 * being one, and a register header is a document index rather than a place to
 * sell from.
 *
 * And it is the *site's* action, taken from the entry page, rather than
 * whatever the current page happens to declare. Reading it per page put the
 * not-found page's "Back to home" recovery link in the header, so a visitor who
 * mistyped an address was offered the same link twice and the header advertised
 * a route out instead of a way to make contact. A header ask that changes with
 * the page is not a header ask.
 *
 * A page outside the navigation carries none at all: the recovery surface is
 * reached by accident and is not a place to convert from.
 */
const conversionAction = navigation[0]?.primaryAction ?? null;
const carriesHeaderAction = (NAVIGATION_FAMILY === 'utility' || NAVIGATION_FAMILY === 'centred') && page.navigation.visible;
const headerAction = carriesHeaderAction ? conversionAction : null;

// Everything in the footer is business information. Factory diagnostics stay
// development-only: publishing them put build metadata in front of customers.
const contact = composed.sections.find((item) => item.type === 'contact-panel');
const footerEmail = contact ? binding(contact, 'email') : undefined;
const footerPhone = contact ? binding(contact, 'phone') : undefined;
const areas = composed.sections.find((item) => item.type === 'location-list');
const areaItems = areas ? binding(areas, 'items')?.value : null;
const areaNames = Array.isArray(areaItems) ? areaItems.map(itemTitle).filter(Boolean) : [];
const year = new Date().getFullYear();
const socialProfilesValue = contact ? binding(contact, 'profiles')?.value : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f5f2" />
    {/* The base the site is served under, so the Builder bridge can resolve a
        route inside a Console preview mount without the composition knowing
        anything about where it is hosted. */}
    <meta name="app-builder-base" content={import.meta.env.BASE_URL} />
    {/* A capability recipe owns page metadata. The template owns the document. */}
    {recipeHead.map((Head) => <Head page={page} />)}
    {recipeHead.length === 0 && <title>{page.title}</title>}
  </head>
  <body>
    <div class={`site-frame ${SHELL_CLASSES}`.trim()} data-scenario={currentScenario}>
      {/* The families differ in structure, not paint. `centred` puts the brand
          on its own row above the destinations, so it needs a wrapper the
          others do not have; `register` numbers each destination with a real
          element, the way the register grammar numbers an entry; `editorial`
          carries no boxed control at all. Every family keeps the same
          destinations, the same hrefs and the same `aria-current`, because a
          header may change what it looks like and never where it goes. */}
      <header class={`site-header nav-${NAVIGATION_FAMILY}`} data-navigation-family={NAVIGATION_FAMILY}>
        <div class="site-header-brand">
          <a class="site-brand" href={siteHref('/')}>{project.name}</a>
          {/* Rendered open, then collapsed by the progressive-enhancement script
              below. A visitor with no JavaScript keeps every destination; the
              alternative — shipping it closed and depending on a script to open
              it — is a navigation that does not exist without JavaScript. */}
          <button type="button" class="nav-toggle" aria-expanded="true" aria-controls="primary-navigation" hidden>Menu</button>
        </div>
        <nav id="primary-navigation" aria-label="Primary navigation" data-open="true">
          {navigation.map((entry, index) => (
            <a class={entry.id === page.id ? 'active' : ''} href={siteHref(entry.path)} aria-current={entry.id === page.id ? 'page' : undefined}>
              {NAVIGATION_FAMILY === 'register' && <span class="nav-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
              <span class="nav-label">{entry.navigation.label}</span>
            </a>
          ))}
        </nav>
        {headerAction && (
          <a class="nav-action" href={siteHref(headerAction.href)}>{headerAction.label}</a>
        )}
      </header>
      <main class="app-shell" data-page-id={page.id} data-mobile-hero={MOBILE_HERO}>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-identity">
          <strong>{project.name}</strong>
          {areaNames.length > 0 && <span>{areaNames.join(' · ')}</span>}
          <small>© {year} {project.name}</small>
        </div>
        <div class="footer-contact">
          {footerEmail && <a href={`mailto:${text(footerEmail.value)}`}>{text(footerEmail.value)}</a>}
          {footerPhone && <a href={`tel:${text(footerPhone.value).replace(/\s+/g, '')}`}>{text(footerPhone.value)}</a>}
          {contact && <SocialLinks profiles={socialProfilesValue} />}
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          {navigation.map((entry) => <a href={siteHref(entry.path)}>{entry.navigation.label}</a>)}
        </nav>
      </footer>
    </div>

    {/* Progressive enhancement, inline and tiny, in that order.
        `is:inline` keeps it out of the bundle, so a marketing page still ships
        no module graph. Everything below degrades to a usable page when it does
        not run: the navigation is already open, and edit mode is a Console
        concern that a deployed visitor never triggers. */}
    <script is:inline>
      (function () {
        var toggle = document.querySelector('.site-header .nav-toggle');
        var nav = document.getElementById('primary-navigation');
        if (toggle && nav) {
          toggle.hidden = false;
          nav.dataset.open = 'false';
          toggle.setAttribute('aria-expanded', 'false');
          var setOpen = function (open) {
            nav.dataset.open = open ? 'true' : 'false';
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            toggle.textContent = open ? 'Close' : 'Menu';
          };
          toggle.addEventListener('click', function () {
            setOpen(nav.dataset.open !== 'true');
          });
          // Escape closes it and returns the reader to the control they opened
          // it with, rather than leaving focus inside a panel that is gone.
          document.addEventListener('keydown', function (event) {
            if (event.key !== 'Escape' || nav.dataset.open !== 'true') return;
            setOpen(false);
            toggle.focus();
          });
          // A destination inside a collapsed panel is still in the document and
          // still focusable, so a keyboard reader could tab into a panel nobody
          // can see. Opening on focus keeps the panel and the focus ring in
          // agreement without taking any destination out of the document.
          nav.addEventListener('focusin', function () {
            if (window.matchMedia('(max-width: 880px)').matches) setOpen(true);
          });
        }

        // Builder edit mode. Off unless the page is opened with `?__builder=1`,
        // so a deployed site never carries selection behaviour. The frame
        // reports coordinates only — page, section, element key — and the
        // Console resolves them to a full identity through the service.
        if (!new URLSearchParams(window.location.search).has('__builder')) return;
        var pageId = document.querySelector('main')?.dataset.pageId || '';
        var base = (document.querySelector('meta[name="app-builder-base"]')?.content || '/').replace(/\/+$/, '');
        function route() {
          var pathname = window.location.pathname;
          if (!base || !pathname.startsWith(base)) return pathname || '/';
          var rest = pathname.slice(base.length);
          return rest.startsWith('/') ? rest : '/' + rest;
        }
        document.documentElement.classList.add('builder-mode');
        document.addEventListener('click', function (event) {
          var target = event.target && event.target.closest ? event.target.closest('[data-element-key]') : null;
          if (!target) return;
          event.preventDefault();
          event.stopPropagation();
          var marked = document.querySelectorAll('.builder-selected');
          for (var i = 0; i < marked.length; i += 1) marked[i].classList.remove('builder-selected');
          target.classList.add('builder-selected');
          var section = target.closest('[data-section-id]');
          window.parent.postMessage({
            source: 'app-builder-preview',
            type: 'element-selected',
            pageId: pageId,
            sectionId: target.dataset.sectionId || (section ? section.dataset.sectionId : undefined),
            elementKey: target.dataset.elementKey,
            bindingKey: target.dataset.bindingKey || null,
            origin: target.dataset.bindingOrigin,
            generated: target.dataset.generated === 'true',
            value: target.dataset.bindingKey ? target.textContent || '' : '',
            path: route(),
          }, '*');
        }, true);
        window.parent.postMessage({ source: 'app-builder-preview', type: 'ready', path: route() }, '*');
      })();
    </script>
    {recipeBodyEnd.map((BodyEnd) => <BodyEnd />)}
  </body>
</html>
