{
  "schemaVersion": 1,
  "id": "astro-static-content",
  "version": "1.0.0",
  "status": "ready",
  "projectTypes": [
    "marketing-site",
    "content-site"
  ],
  "filesRoot": "files",
  "renderer": "static-content",
  "sharedFiles": [
    {
      "from": "presentation/tokens.css",
      "to": "src/design/tokens.css"
    },
    {
      "from": "presentation/styles.css",
      "to": "src/styles.css"
    }
  ],
  "generated": {
    "root": "src/generated",
    "recipeRegistry": {
      "file": "src/generated/recipes.ts",
      "format": "static"
    }
  },
  "scenarioEnvVar": "PUBLIC_APP_SCENARIO",
  "previewEnv": {
    "ASTRO_DEV_BACKGROUND": "0"
  },
  "managedFiles": [
    "src/generated/project.ts",
    "src/generated/recipes.ts",
    "src/generated/composition.ts",
    "src/generated/design.ts",
    "src/generated/brand.css",
    "src/generated/assets.ts",
    "src/generated/scenarios.ts",
    ".app-builder/manifest.json",
    ".app-builder/project.json",
    ".app-builder/recipes.json",
    ".app-builder/template-package.json",
    "README.md"
  ],
  "presentation": {
    "version": "1.1.0",
    "renderer": "src/components/Section.astro",
    "tokenSource": "src/design/tokens.css",
    "elementRoles": {
      "display": {
        "editableProperties": [
          "text"
        ],
        "designTokens": [
          "--color-ink",
          "--text-4xl"
        ]
      },
      "heading": {
        "editableProperties": [
          "text"
        ],
        "designTokens": [
          "--color-ink",
          "--text-3xl"
        ]
      },
      "body-copy": {
        "editableProperties": [
          "text"
        ],
        "designTokens": [
          "--color-text-muted",
          "--text-lg"
        ]
      },
      "eyebrow": {
        "editableProperties": [
          "text"
        ],
        "designTokens": [
          "--color-accent",
          "--text-sm"
        ]
      },
      "detail": {
        "editableProperties": [],
        "designTokens": [
          "--color-ink",
          "--color-border",
          "--layout-radius"
        ]
      },
      "collection": {
        "editableProperties": [],
        "designTokens": [
          "--color-surface",
          "--layout-radius",
          "--shadow-soft"
        ]
      },
      "action": {
        "editableProperties": [],
        "designTokens": [
          "--color-accent",
          "--color-accent-contrast",
          "--radius-pill"
        ]
      },
      "asset": {
        "editableProperties": [],
        "designTokens": [
          "--layout-radius",
          "--shadow-lifted"
        ]
      },
      "section": {
        "editableProperties": [],
        "designTokens": [
          "--section-space",
          "--layout-max-width"
        ]
      }
    },
    "components": {
      "hero": {
        "id": "hero-section",
        "version": "1.0.0",
        "bindingRoles": {
          "eyebrow": "eyebrow",
          "title": "display",
          "body": "body-copy"
        },
        "defaultBindingRole": "collection",
        "actions": true,
        "assets": true,
        "variants": [
          {
            "id": "primary",
            "label": "Full",
            "purpose": "Full-height introduction. Best for a landing surface."
          },
          {
            "id": "compact",
            "label": "Compact",
            "purpose": "Reduced vertical space. Best for a secondary page that gets to the point."
          }
        ]
      },
      "rich-text": {
        "id": "rich-text-section",
        "version": "1.0.0",
        "bindingRoles": {
          "title": "heading",
          "body": "body-copy"
        },
        "defaultBindingRole": "collection",
        "actions": true,
        "assets": false,
        "variants": []
      },
      "item-grid": {
        "id": "item-grid-section",
        "version": "1.0.0",
        "bindingRoles": {
          "title": "heading",
          "body": "body-copy"
        },
        "defaultBindingRole": "collection",
        "actions": true,
        "assets": false,
        "variants": [
          {
            "id": "cards",
            "label": "Cards",
            "purpose": "A grid of cards. Best where each item has detail worth reading."
          },
          {
            "id": "list",
            "label": "List",
            "purpose": "One line per item. Best where items are names with nothing else to say."
          },
          {
            "id": "features",
            "label": "Feature columns",
            "purpose": "A denser two-column rule-marked list. Best for many short items."
          }
        ]
      },
      "proof-grid": {
